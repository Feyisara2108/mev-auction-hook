# ─── Copy this file to .env and fill in your values ─────────────────────────
# .env is gitignored — never commit your private key.

# Your deployer wallet private key (with or without 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Unichain Sepolia RPC URL (chainId 1301)
# Free public endpoint: https://sepolia.unichain.org
# Or sign up at https://www.alchemy.com for a dedicated key
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org

# Uniscan API key — required for --verify flag (source verification)
# Get one free at https://sepolia.uniscan.xyz (register → API Keys)
UNISCAN_API_KEY=YOUR_UNISCAN_API_KEY_HERE

# ─── Filled in after each deployment step ────────────────────────────────────

# Address of the deployed MevAuctionHook — filled in after step 1
HOOK_ADDRESS=

# ERC-20 token addresses for the pool — filled in after deploying or choosing tokens
# These must be sorted: TOKEN0_ADDRESS < TOKEN1_ADDRESS (numerically by address)
TOKEN0_ADDRESS=
TOKEN1_ADDRESS=

# Swap interaction — used by 06_RequestSwap and 07_SubmitBid
REQUEST_ID=
BID_AMOUNT=
